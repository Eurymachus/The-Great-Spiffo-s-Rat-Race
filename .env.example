# Production application settings. Local development uses the safe defaults in
# config.settings; production runs with config.settings_production and requires
# every value in this section.
DJANGO_SECRET_KEY=
DJANGO_CSRF_TRUSTED_ORIGINS=https://tgsrr.com,https://www.tgsrr.com
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO
RELEASE_ID=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
# Use cache for the Linux Compose deployment. The native Windows candidate uses
# database and does not require REDIS_URL.
RUNTIME_STATE_BACKEND=cache
REDIS_URL=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=noreply@tgsrr.com
MICROSOFT_GRAPH_REPLY_TO=support@tgsrr.com
DEFAULT_FROM_EMAIL=The Great Spiffo's Rat Race <noreply@tgsrr.com>
SERVER_EMAIL=The Great Spiffo's Rat Race <noreply@tgsrr.com>
STATIC_ROOT=
MEDIA_ROOT=
AVATAR_QUARANTINE_ROOT=
TRUST_CLOUDFLARE_CONNECTING_IP=true

# Production must replace these localhost Turnstile test credentials.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Required in production so automatic participant-avatar moderation is active.
OPENAI_API_KEY=

# Twitch channel linking. Generate STREAMING_TOKEN_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STREAMING_TOKEN_ENCRYPTION_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/account/streaming/twitch/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/account/connections/discord/callback/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/account/streaming/youtube/callback/

# Full Project Zomboid reference source. Do not put a Steam password, Steam
# Guard code, or SteamCMD config.vdf in this file.
STEAMCMD_EXECUTABLE=
STEAMCMD_USERNAME=
STEAM_WEB_API_KEY=
PZ_REFERENCE_ROOT=
STEAMCMD_UPDATE_TIMEOUT_SECONDS=1800
STEAMCMD_AUTH_TIMEOUT_SECONDS=15
JAVA_EXECUTABLE=java
VINEFLOWER_JAR=
PZ_DECOMPILED_ROOT=
PZ_DECOMPILATION_TIMEOUT_SECONDS=3600
